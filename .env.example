# --- БД сайта SplitHome (read-only) ---
# Те же значения, что в /opt/oasis/.env проекта сайта. На сервере БД — это
# контейнер `db`; с хоста подключаться к опубликованному порту (обычно
# localhost:5432) либо запускать сервис в той же docker-сети с host=db.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=splithome
DB_USER=splithome
DB_PASSWORD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Личный chat_id владельца (написать боту → взять из getUpdates или у @userinfobot).
TELEGRAM_OWNER_CHAT_ID=1264067528
# На VPS с блокировкой Telegram IPv4 — через socat-proxy, напр. https://api.telegram.org:8443
TELEGRAM_API_URL=https://api.telegram.org

# --- Бриз API (только ради опт-цены base Бриза) ---
# В БД сайта у Бриза лежит розница; опт (base/закупку) Бриз отдаёт лишь в своём API.
# Значения те же, что в /opt/oasis/.env сайта. Пусто → опт Бриза = цена из БД (розница).
BREEZ_BASE_URL=https://api.breez.ru/v1/
BREEZ_AUTH_HEADER=

# --- Фотоген-агент (генерация рекламных карточек товара) ---
# Stock Bot и фотоген-агент работают на одном VPS → обращаемся по localhost.
# FOTOGEN_API_TOKEN = API_TOKEN из .env фотоген-агента (/root/ritualb2b/.env).
# Пусто → кнопка «🎨 Создать карточку» вернёт ошибку «не задан».
FOTOGEN_API_URL=http://127.0.0.1:8765
FOTOGEN_API_TOKEN=

# --- JAC (4-й поставщик, без API) ---
# Путь к JSON, который пишет скрапер b2b-jac.com (проект osatakti_mdv_b2b).
# Скрапер должен отработать ДО суточного отчёта (cron раньше 09:00). Пусто или
# файла нет → JAC просто не включается в отчёт. Пример (на VPS):
#   JAC_STOCK_JSON=/opt/osatakti_mdv_b2b/data/jac_stock_latest.json
JAC_STOCK_JSON=
# ТТХ карточек JAC (команда `specs` скрапера). Пусто → без характеристик.
#   JAC_SPECS_JSON=/opt/osatakti_mdv_b2b/data/jac_specs_latest.json
JAC_SPECS_JSON=
# УТП серий JAC (jac_utp_latest.json — отобранные владельцем преимущества по сериям).
# В меню по кнопке «✅ С характеристиками» добавляется блок «птички»-УТП серии.
# Пусто/файла нет → меню работает без блока УТП. Пример (на VPS):
#   JAC_UTP_JSON=/opt/osatakti_mdv_b2b/data/jac_utp_latest.json
JAC_UTP_JSON=

# --- Read-only поиск для тендерного агента ---
# Отдельный случайный токен длиной не менее 32 символов. Не используйте здесь
# Telegram-токен или ключи поставщиков.
TENDER_CLIMATE_API_TOKEN=
TENDER_CLIMATE_API_HOST=127.0.0.1
TENDER_CLIMATE_API_PORT=8780
