# --- БД сайта SplitHome (read-only) ---
# Те же значения, что в /opt/oasis/.env проекта сайта. На сервере БД — это
# контейнер `db`; с хоста подключаться к опубликованному порту (обычно
# localhost:5432) либо запускать сервис в той же docker-сети с host=db.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=splithome
DB_USER=splithome
DB_PASSWORD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Личный chat_id владельца (написать боту → взять из getUpdates или у @userinfobot).
TELEGRAM_OWNER_CHAT_ID=1264067528
# На VPS с блокировкой Telegram IPv4 — через socat-proxy, напр. https://api.telegram.org:8443
TELEGRAM_API_URL=https://api.telegram.org

# --- Бриз API (только ради опт-цены base Бриза) ---
# В БД сайта у Бриза лежит розница; опт (base/закупку) Бриз отдаёт лишь в своём API.
# Значения те же, что в /opt/oasis/.env сайта. Пусто → опт Бриза = цена из БД (розница).
BREEZ_BASE_URL=https://api.breez.ru/v1/
BREEZ_AUTH_HEADER=

# --- Фотоген-агент (генерация рекламных карточек товара) ---
# Stock Bot и фотоген-агент работают на одном VPS → обращаемся по localhost.
# FOTOGEN_API_TOKEN = API_TOKEN из .env фотоген-агента (/root/ritualb2b/.env).
# Пусто → кнопка «🎨 Создать карточку» вернёт ошибку «не задан».
FOTOGEN_API_URL=http://127.0.0.1:8765
FOTOGEN_API_TOKEN=
